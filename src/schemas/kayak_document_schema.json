{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kayakulator Document",
  "type": "object",
  "required": ["metadata", "offsets"],
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "name": {"type": ["string", "null"]},
        "schema_version": {"type": "integer"}
      },
      "required": ["schema_version"]
    },
    "offsets": {"type": "object"},
    "frame_locations": {"type": "array", "items": {"type": ["number", "null"]}},
    "default_profile_shape": {"type": ["object", "null"]},
    "member_properties": {"type": "object"}
  }
}
